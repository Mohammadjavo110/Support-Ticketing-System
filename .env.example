# Copy to .env and adjust. Never commit the real .env.
POSTGRES_USER=ticket
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=tickets

# Engine (stage 1 — typed decisions). Two different URLs:
#   LAYA_API_URL     — where the WORKER POSTs /predict. Inside compose that is
#                       the internal http://laya-serve:8000/predict.
#   LAYA_UPSTREAM_URL — laya-serve's own upstream, an external model API used
#                       only in hosted mode. Hosted activates only when this
#                       starts with https:// AND LAYA_UPSTREAM_KEY is set, so
#                       an internal http URL can never create a request loop.
#                       If the URL contains /chat/completions it is called as
#                       an OpenAI-compatible {model, messages} endpoint;
#                       otherwise the legacy {text, questions} contract is used.
ENGINE_PROVIDER=laya
LAYA_API_URL=http://laya-serve:8000/predict
LAYA_API_KEY=
LAYA_UPSTREAM_URL=
LAYA_UPSTREAM_KEY=
LAYA_MODEL=laya-multilingual
ENGINE_MIN_CONFIDENCE=0.55
ENGINE_TIMEOUT_SECONDS=8

# Draft reply (stage 2). OpenAI-compatible chat endpoint, e.g.
#   https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# Leave LLM_API_KEY empty to disable the LLM and return an empty draft
# (draft_status=failed) — the decision still lands.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

SECRET_KEY=dev_only_change_me
SESSION_TTL_HOURS=72

# Comma separated origins for the dev server
CORS_ORIGINS=http://localhost:5173

# Host port the API is published on. Override when 8000 is taken by something
# else on your machine; the UI does not depend on it (it proxies /api).
API_PORT=8000
